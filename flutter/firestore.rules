rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function optionalInt(data, key, minimum, maximum) {
      return !(key in data)
        || (data[key] is int
          && data[key] >= minimum
          && data[key] <= maximum);
    }

    function optionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function validGame(game) {
      return game is map
        && game.level is int
        && game.level >= 1
        && game.level <= 20
        && game.score is int
        && game.score >= 0
        && game.score <= 1000000
        && optionalInt(game, 'bestTimeSeconds', 0, 86400)
        && optionalInt(game, 'moves', 0, 10000)
        && optionalBool(game, 'challengeMode')
        && game.updatedAt is timestamp;
    }

    function validSettings(settings) {
      return settings is map
        && optionalBool(settings, 'gridVisible')
        && optionalBool(settings, 'musicEnabled')
        && optionalBool(settings, 'promoNotifications')
        && optionalBool(settings, 'inactivityNotifications')
        && optionalBool(settings, 'energyFullNotifications')
        && (!('themeName' in settings)
          || (settings.themeName is string
            && settings.themeName.size() <= 30))
        && settings.updatedAt is timestamp;
    }

    function validInventory(inventory) {
      return inventory is map
        && inventory.tokens is int
        && inventory.tokens >= 0
        && inventory.tokens <= 1000000
        && inventory.energy is int
        && inventory.energy >= 0
        && inventory.energy <= 5
        && inventory.unlimited is bool
        && inventory.themePack is bool
        && optionalBool(inventory, 'customThemeUnlocked')
        && inventory.noAds is bool
        && (!('gridUnlockedLevels' in inventory)
          || (inventory.gridUnlockedLevels is list
            && inventory.gridUnlockedLevels.size() <= 17))
        && optionalInt(inventory, 'freeHintsUsed', 0, 10)
        && (!('purchaseHistory' in inventory)
          || (inventory.purchaseHistory is list
            && inventory.purchaseHistory.size() <= 50))
        && inventory.updatedAt is timestamp;
    }

    function validUser(userId) {
      return request.resource.data.uid == userId
        && (!('game' in request.resource.data)
          || validGame(request.resource.data.game))
        && (!('settings' in request.resource.data)
          || validSettings(request.resource.data.settings))
        && (!('inventory' in request.resource.data)
          || validInventory(request.resource.data.inventory));
    }

    function isDeveloper() {
      return request.auth != null
        && request.auth.token.email == 'ah.subhan@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isSignedInAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validRewards(rewards) {
      return rewards is map
        && rewards.keys().hasOnly(
          ['tokens', 'energy', 'themePack', 'customTheme', 'noAds'])
        && rewards.tokens is int
        && rewards.tokens >= 0
        && rewards.tokens <= 10000
        && rewards.energy is int
        && rewards.energy >= 0
        && rewards.energy <= 5
        && rewards.themePack is bool
        && rewards.customTheme is bool
        && rewards.noAds is bool
        && (rewards.tokens > 0
          || rewards.energy > 0
          || rewards.themePack
          || rewards.customTheme
          || rewards.noAds);
    }

    function validCoupon(couponId) {
      return request.resource.data.keys().hasOnly([
          'code',
          'label',
          'active',
          'startsAt',
          'expiresAt',
          'maxRedemptions',
          'redemptionCount',
          'rewards',
          'createdAt',
          'createdBy',
          'updatedAt',
          'lastRedeemedAt'
        ])
        && request.resource.data.code == couponId
        && couponId.matches('^[A-Z0-9-]{4,24}$')
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 100
        && request.resource.data.active is bool
        && request.resource.data.startsAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.resource.data.startsAt
        && request.resource.data.maxRedemptions is int
        && request.resource.data.maxRedemptions > 0
        && request.resource.data.maxRedemptions <= 100000
        && request.resource.data.redemptionCount is int
        && request.resource.data.redemptionCount >= 0
        && request.resource.data.redemptionCount
          <= request.resource.data.maxRedemptions
        && validRewards(request.resource.data.rewards)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && (!('lastRedeemedAt' in request.resource.data)
          || request.resource.data.lastRedeemedAt is timestamp);
    }

    function validCouponClaim(couponId) {
      let redemptionId = request.auth.uid + '_' + couponId;
      let redemption = getAfter(
        /databases/$(database)/documents/coupon_redemptions/$(redemptionId)
      ).data;
      return isSignedInAccount()
        && resource.data.active
        && request.time >= resource.data.startsAt
        && request.time <= resource.data.expiresAt
        && resource.data.redemptionCount < resource.data.maxRedemptions
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['redemptionCount', 'lastRedeemedAt'])
        && request.resource.data.redemptionCount
          == resource.data.redemptionCount + 1
        && request.resource.data.lastRedeemedAt == request.time
        && redemption.uid == request.auth.uid
        && redemption.code == couponId
        && redemption.rewards == resource.data.rewards
        && redemption.redeemedAt == request.time;
    }

    function validRedemption(couponId, redemptionId) {
      let coupon = get(
        /databases/$(database)/documents/coupons/$(couponId)
      ).data;
      let nextCoupon = getAfter(
        /databases/$(database)/documents/coupons/$(couponId)
      ).data;
      return isSignedInAccount()
        && redemptionId == request.auth.uid + '_' + couponId
        && request.resource.data.keys().hasOnly(
          ['uid', 'code', 'rewards', 'redeemedAt', 'platform'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == couponId
        && request.resource.data.rewards == coupon.rewards
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.platform is string
        && coupon.active
        && request.time >= coupon.startsAt
        && request.time <= coupon.expiresAt
        && coupon.redemptionCount < coupon.maxRedemptions
        && nextCoupon.redemptionCount == coupon.redemptionCount + 1;
    }

    match /users/{userId} {
      allow read, delete:
        if request.auth != null
        && request.auth.uid == userId;
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && validUser(userId);
    }

    match /feedback/{feedbackId} {
      allow create:
        if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (!('senderName' in request.resource.data)
          || (request.resource.data.senderName is string
            && request.resource.data.senderName.size() > 0
            && request.resource.data.senderName.size() <= 100))
        && (
          (request.resource.data.provider == 'account'
            && request.auth.token.firebase.sign_in_provider != 'anonymous')
          || (request.resource.data.provider == 'guest'
            && request.auth.token.firebase.sign_in_provider == 'anonymous')
        )
        && request.resource.data.platform is string
        && request.resource.data.appVersion is string
        && request.resource.data.buildNumber is string
        && request.resource.data.status in ['new', 'pending_review']
        && request.resource.data.createdAt is timestamp
        && (!('category' in request.resource.data)
          || request.resource.data.category == 'account_deletion')
        && (!('reviewWithinHours' in request.resource.data)
          || request.resource.data.reviewWithinHours == 24)
        && (!('attachment' in request.resource.data)
          || (
            request.resource.data.attachment is map
            && request.resource.data.attachment.keys().hasOnly(
              ['name', 'path', 'url', 'contentType', 'size']
            )
            && request.resource.data.attachment.name is string
            && request.resource.data.attachment.name.size() > 0
            && request.resource.data.attachment.name.size() <= 255
            && request.resource.data.attachment.path is string
            && request.resource.data.attachment.path.matches(
              '^feedback/' + request.auth.uid + '/' + feedbackId + '/.*$'
            )
            && request.resource.data.attachment.url is string
            && request.resource.data.attachment.contentType is string
            && request.resource.data.attachment.size is int
            && request.resource.data.attachment.size > 0
            && request.resource.data.attachment.size <= 10 * 1024 * 1024
          ));
      allow read: if isDeveloper();
      allow update:
        if isDeveloper()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in
          ['new', 'pending_review', 'read', 'resolved']
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    match /coupons/{couponId} {
      allow get: if isSignedInAccount();
      allow list: if isDeveloper();
      allow create, delete: if isDeveloper() && validCoupon(couponId);
      allow update:
        if (isDeveloper() && validCoupon(couponId))
        || validCouponClaim(couponId);
    }

    match /coupon_redemptions/{redemptionId} {
      allow read:
        if isDeveloper()
        || (request.auth != null
          && resource.data.uid == request.auth.uid);
      allow create:
        if validRedemption(request.resource.data.code, redemptionId);
      allow update, delete: if false;
    }
  }
}
